# Passed by the organizers at launch (never commit real values):
LLM_BASE_URL=
LLM_API_KEY=

# Everything below is optional; defaults are tuned for the competition.
# Main model (first pass) and second-opinion model (second pass, "none" disables it):
AGENT_MODEL=qwen3.8-27b-noreason
AGENT_SECOND_MODEL=qwen3.8-27b
# Known budget in competition tokens (input/10 + output). Unset = unknown, the proxy enforces it.
BUDGET=
# Parallel tasks / LLM requests (the rules allow up to 5 sessions).
AGENT_CONCURRENCY=4
# Stop starting new work after this many seconds (hard limit is 1 hour).
AGENT_DEADLINE_S=3300
# Where to write trajectories.jsonl and summary.json (default: not written).
AGENT_LOG_DIR=
