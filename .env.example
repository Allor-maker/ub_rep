# Template only. A3 reads these values explicitly; no automatic .env loading.
# Final values are supplied by the organizers; do not hard-code a public endpoint.
LLM_BASE_URL=
LLM_API_KEY=

# Standard CLI: key + URL enables controlled-risk competition A7.1, no adapter.
# No key: offline fallback. --llm-mode overrides LLM_MODE.
LLM_MODE=competition
LLM_MODEL=qwen3.6-35b-a3b-noreason
# Optional independent selection for review calls (same four permitted IDs).
LLM_REVIEW_MODEL=qwen3.6-35b-a3b-noreason
LLM_OUTPUT_CAP=512
# Competition HTTP timeout; bounded by the remaining attempt/run deadline.
# CLI --attempt-timeout-s defaults to 60; --timeout-s is the separate run deadline.
LLM_HTTP_TIMEOUT_S=45
# Only strict mode requires this trusted code. No real-provider adapter is shipped.
# Estimates/usage arithmetic and successful smokes are never attestations.
LLM_COMPATIBILITY_ADAPTER=
# To force offline even when a key is injected: --components nsu_budget_agent.solvers.composition:build

# The final documented CLI is --tasks-dir /data/tasks.
# BUDGET=100000 means 100000 competition tokens = 1000000 internal Units.
# TASKS / OUT forwarding and output format are unresolved.
# Add their settings only after agreeing on the launch contract.

# A7.5 recommended recovery policy (legacy defaults remain opt-in).
# Unsupported independent semantics stop before HTTP; one affordable length retry.
LLM_REQUIRE_INDEPENDENT=1
LLM_LENGTH_RETRY=1
